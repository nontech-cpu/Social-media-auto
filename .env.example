# ==============================================================================
# Ocoya-Style Instagram AI Planner & Auto-Poster - Environment Configuration
# ==============================================================================
# Copy this file to `.env` (for backend) and `frontend/.env.local` (for frontend).

# --- App & Deployment URLs ---
APP_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# --- Database ---
# Localhost default (SQLite async):
DATABASE_URL=sqlite+aiosqlite:///./social_media_ai.db
# Production (Neon / Supabase PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DBNAME?sslmode=require

# --- Security & Secrets ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# Secret used to sign OAuth state tokens and protect /api/worker/tick cron endpoint
APP_SECRET_KEY=change-me-to-a-long-random-string
CRON_SECRET=change-me-cron-secret

# --- Meta Graph API (Facebook Login for Business -> Instagram Business/Creator) ---
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8000/api/auth/instagram/callback
META_GRAPH_VERSION=v21.0
META_LOGIN_CONFIG_ID=
META_OAUTH_SCOPES=instagram_basic,instagram_manage_insights,instagram_content_publish,pages_show_list,pages_read_engagement,business_management

# --- Google Business Profile OAuth & API ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_GBP_REDIRECT_URI=http://localhost:8000/api/auth/google-business/callback
GOOGLE_GBP_SCOPES="https://www.googleapis.com/auth/business.manage openid email profile"
GBP_AUTO_REPLY_MIN_STARS=4

# --- Google Gemini AI ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3-flash-preview,gemini-3.1-flash-lite,gemini-3.8-flash,gemini-3.6-flash,gemini-3.7-flash
GEMINI_ENABLE_SEARCH_GROUNDING=true

# --- Public Media Storage (Required by Instagram Graph API for Reels/Images) ---
# Options: cloudinary | s3 | local
# Use 'cloudinary' (Free Tier) on Render/Production so files survive restarts & have HTTPS URLs.
MEDIA_STORAGE_PROVIDER=local
CLOUDINARY_URL=
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# --- Scheduler, Token & Media Limits ---
ENABLE_INTERNAL_SCHEDULER=true
WORKER_POLL_INTERVAL_SECONDS=30
WORKER_BATCH_LIMIT=10
STALE_PUBLISH_LOCK_MINUTES=10
INSIGHTS_SYNC_INTERVAL_HOURS=6
TOKEN_REFRESH_THRESHOLD_DAYS=10
MAX_PUBLISH_RETRIES=3
HASHTAG_WEEKLY_QUOTA=30
HASHTAG_MAX_LIVE_LOOKUPS=4

# --- 7-Stage Recommendation Engine Hyperparameters ---
REC_LIKES_WEIGHT=1.0
REC_COMMENTS_WEIGHT=2.5
REC_SHARES_WEIGHT=4.0
REC_SAVES_WEIGHT=4.0
REC_CLICKS_WEIGHT=2.0
REC_HALF_LIFE_DAYS=30.0
REC_BAYESIAN_M=3.0
REC_LOOKBACK_DAYS=90
REC_PLATFORM_MIN_GAP_HOURS=12
REC_MIN_LEAD_MINUTES=30
